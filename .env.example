# Скопируй в .env. Настоящие значения вводи только в .env: он исключён из Git.
# Запуск: uv run --env-file .env -- hermes.cmd --profile drawer-assistant <команда>

# Hermes использует уже установленное окружение и профиль drawer-assistant.
# HERMES_HOME не переопределяем: новый корень потребует нового окружения Hermes.
# Профиль создаётся один раз: hermes profile create drawer-assistant --no-alias

# Вставь токен созданного бота, полученный от @BotFather.
TELEGRAM_BOT_TOKEN=

# Числовые Telegram user ID тех, кто может общаться с ботом, через запятую.
# Это НЕ @username. Свой ID можно узнать у @userinfobot.
TELEGRAM_ALLOWED_USERS=

# ChatGPT OAuth: сюда НЕ нужно вставлять API key или OAuth-токены.
# Вход: uv run --env-file .env -- hermes.cmd --profile drawer-assistant model
# Выбери OpenAI Codex / вход через ChatGPT. Авторизацию хранит сам Hermes.

# Ниже — контракт настроек будущего плагина: пока он ещё не реализован.
# Часовой пояс художницы; поправь, если он отличается от этого ноутбука.
DRAWER_TIMEZONE=Europe/Kaliningrad
DRAWER_DATA_DIR=${LOCALAPPDATA}/drawer-assistant/data

# hermes — облачная генерация; comfyui — твой GPU-сервер; mock — тесты.
DRAWER_IMAGE_PROVIDER=hermes

# Базовый HTTP(S)-адрес ComfyUI, без /prompt и без /api в конце.
# Пример для SSH-туннеля: http://127.0.0.1:8188
# Для удалённого сервера укажи его доступный с ноутбука адрес.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Необязательно: Bearer-токен ТВОЕГО reverse proxy, если он требует авторизацию.
# У обычного локального ComfyUI такого ключа нет; тогда оставь пустым.
COMFYUI_API_KEY=

# Максимальное ожидание генерации, в секундах.
COMFYUI_TIMEOUT_SECONDS=300
