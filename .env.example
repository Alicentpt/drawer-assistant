# Скопируй в .env, заполни первые два поля, выполни: uv run drawer-setup
# Команда устанавливает Джессику, инструменты, таймер и ограничения группы.
# Повтори после изменения настроек или обновления кода. Секреты не коммитим.

# Токен созданного бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Один ОТРИЦАТЕЛЬНЫЙ числовой ID группы, например -1001234567890.
# Не ссылка-приглашение и не user ID. Как узнать — см. README.
DRAWER_TELEGRAM_CHAT_ID=

# Личка запрещена настройщиком; TELEGRAM_ALLOWED_USERS заполнять не нужно.
# Группа/тема — одна история и модель для всех участников; /model и /new общие.
# drawer-setup выставляет group_sessions_per_user=false на хосте Hermes и в профиле.
# Это настройка общего gateway: касается групп других ботов на том же хосте тоже.
# OAuth хранит Hermes. Вход: hermes.cmd --profile drawer-assistant model
# Gateway общий: uv run poe bot (БЕЗ uv --env-file .env).

# DeepSeek через OpenRouter — модель самой Джессики, не генератор изображений.
# Ключ: https://openrouter.ai/keys (нужен баланс OpenRouter, подписка ChatGPT не подходит).
# Для включения заполни ОБА поля, затем uv run drawer-setup и перезапусти gateway.
# Пример модели: deepseek/deepseek-v4.1-flash (текст, изображения, вызов инструментов).
# Пустая модель сохраняет текущие настройки; это НЕ переключение обратно на OAuth.
OPENROUTER_API_KEY=
DRAWER_OPENROUTER_MODEL=

# SSH только для облачного сервера через uv run poe comfy-tunnel.
# Для ПК художницы через Tailscale эти поля не нужны: см. comfyui/WINDOWS.md.
# Адрес и порт облачного сервера берём из его панели.
COMFYUI_SSH_HOST=
COMFYUI_SSH_PORT=22
COMFYUI_SSH_USER=ubuntu
# Полный путь; одинарные кавычки сохраняют обратные слеши и пробелы.
COMFYUI_SSH_KEY='C:\Users\YOUR_NAME\.ssh\githubcom'

# localhost и адреса Tailscale не должны уходить через HTTP-прокси.
# HTTP-клиент инструментов также исключает *.ts.net напрямую, сохраняя проверку TLS.
NO_PROXY=localhost,127.0.0.1,::1,.ts.net

# Часовой пояс заказов и папка БД/картинок вне Git.
DRAWER_TIMEZONE=Europe/Kaliningrad
# Пусто: drawer-data внутри профиля Hermes; иначе абсолютный путь.
DRAWER_DATA_DIR=
# GPU: localhost через SSH-туннель ИЛИ HTTPS-адрес Tailscale Serve ПК художницы.
# Например: https://artist-pc.example.ts.net (замени адресом из tailscale serve status).
# Общий адрес генераторов; Anima может использовать отдельный сервер ниже.
# Сервер запускается с --gpu-only. После смены URL повтори uv run drawer-setup.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Необязательно: отдельный ComfyUI для Anima; пусто — общий адрес выше.
# RunPod: https://POD_ID-8188.proxy.runpod.net (порт 8188/http должен быть открыт).
COMFYUI_ANIMA_BASE_URL=
# ChatGPT — штатный image tool Hermes через OAuth, без отдельного API-ключа.
# Mock используется в pytest; поддельные картинки в рабочем чате не возвращаем.

# Alibaba Cloud Model Studio: ключ региона Singapore (не OAuth и не Qwen Chat).
# Получи в консоли Model Studio; не присылай ключ в Telegram или Git.
# После заполнения повтори uv run drawer-setup. Пустой ключ отключает Alibaba.
DASHSCOPE_API_KEY=
# Origin без /api/v1. Старый общий адрес Singapore пока поддерживается.
# Лучше адрес workspace из консоли:
# https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com
# Ключ, workspace, доступность модели и endpoint должны относиться к одному региону.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com

# Необязательно: исходники Hermes, если установка не в %LOCALAPPDATA%\hermes\hermes-agent.
# drawer-setup применяет проверяемую compatibility-поправку приёма Telegram-альбомов.
HERMES_SOURCE_DIR=
