{
  "anima_generate": {
    "description": "Generate one Nova Anime AM v2.0 image from text. Defaults: 512x512, CFG7, 45 steps, res_multistep/simple, denoise1. Every reference stretched without padding/cropping before encoding. options can override positive_prefix and negative_prompt (including empty), remove conflicts with requested style. Use anima_batch for variants/panels. Returns immediately with request_id; poll generation_status, do not resubmit uncertain jobs. Read drawer-anima and drawer-anima-controls skills.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 4000,
          "minLength": 1
        },
        "options": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 256,
              "maximum": 768
            },
            "height": {
              "type": "integer",
              "minimum": 256,
              "maximum": 768
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cfg": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sampler": {
              "enum": [
                "res_multistep",
                "euler_ancestral",
                "er_sde"
              ]
            },
            "scheduler": {
              "enum": [
                "simple"
              ]
            },
            "denoise": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "shift": {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "start_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "end_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "positive_prefix": {
              "type": "string",
              "maxLength": 4000
            },
            "negative_prompt": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 1
        },
        "request_id": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_-]{1,48}$"
        }
      },
      "required": [
        "prompt",
        "request_id"
      ],
      "additionalProperties": false
    }
  },
