  "generation_status": {
    "description": "Poll a known request/batch, download images and exact depth previews. Advances batch one child at a time. Wait up to 25 seconds per call. After 3 unchanged checks report pending; no automatic delivery after the turn. Never replace uncertain IDs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      },
      "required": [
        "request_id"
      ],
      "additionalProperties": false
    }
  },
  "generation_health": {
    "description": "Read-only GPU-only, node/model/sampler readiness by mode. Missing controls do not disable text generation. No GPU job is submitted.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
