+"""Regression tests for complete, mention-gated Telegram albums in Drawer."""
+
+import asyncio
+from datetime import datetime, timezone
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from telegram import Bot, Chat, Document, File, Message, MessageEntity, PhotoSize, Update, User
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+@pytest.fixture
+def adapter(monkeypatch: pytest.MonkeyPatch) -> TelegramAdapter:
+    """Create a group-only adapter with real authorization and no network dispatch.
+
+    Args:
+        monkeypatch (pytest.MonkeyPatch): Isolates inherited Telegram environment.
+
+    Returns:
+        TelegramAdapter: Album-enabled adapter with a captured downstream handler.
+    """
+    import os
+    for name in tuple(os.environ):
+        if name.startswith("TELEGRAM_") or name == "GATEWAY_ALLOW_ALL_USERS":
+            monkeypatch.delenv(name, raising=False)
+    instance = TelegramAdapter(PlatformConfig(enabled=True, token="123:fixture", extra={
+        "drawer_complete_albums": True, "require_mention": True,
+        "allowed_chats": ["-100"], "group_allowed_chats": ["-100"],
+        "group_allow_from": ["*"], "allow_from": [], "guest_mode": False,
+        "unauthorized_dm_behavior": "ignore", "observe_unmentioned_group_messages": False,
+    }))
+    instance._bot = SimpleNamespace(id=999, username="hermes_bot")
+    instance.MEDIA_GROUP_WAIT_SECONDS = 0.01
+    instance.handle_message = AsyncMock()
+    return instance
+
+
+def update(index: int, caption: bool, kind: str, chat_id: int = -100,
+           sender: int = 111, album: str = "a", topic: int | None = None) -> Update:
+    """Construct a Telegram update with exactly one real photo or image-document.
+
+    Args:
+        index (int): Unique update and message identifier.
+        caption (bool): Whether this frame mentions the bot.
+        kind (str): Either photo or document.
+        chat_id (int): Telegram chat identifier. Defaults to -100.
+        sender (int): Sender identifier. Defaults to 111.
+        album (str): Telegram media group identifier. Defaults to "a".
+        topic (int | None): Optional forum topic. Defaults to None.
+
+    Returns:
+        Update: One album frame ready for the adapter's normal intake handler.
+    """
+    attachment = (Document(str(index), str(index), file_name=f"{index}.png", mime_type="image/png", file_size=8)
+                  if kind == "document" else PhotoSize(str(index), str(index), 16, 16))
+    attachment.set_bot(Bot("123:fixture"))
+    return Update(index, message=Message(
+        message_id=index, date=datetime.now(timezone.utc),
+        chat=Chat(chat_id, "private" if chat_id > 0 else "supergroup", is_forum=topic is not None),
+        from_user=User(sender, "Alice", False), media_group_id=album,
+        message_thread_id=topic, is_topic_message=topic is not None,
+        caption="@hermes_bot save every image" if caption else None,
+        caption_entities=[MessageEntity("mention", 0, 11)] if caption else None,
+        photo=[attachment] if kind == "photo" else None,
+        document=attachment if kind == "document" else None,
+    ))
+
+
+async def deliver(adapter: TelegramAdapter, updates: list[Update]) -> None:
+    """Feed updates through the public callback and await all album delivery tasks.
+
+    Args:
+        adapter (TelegramAdapter): Isolated adapter with mocked downstream handler.
+        updates (list[Update]): Ordered updates to receive as one Telegram burst.
+
+    Returns:
+        None: All callbacks and the final delayed delivery have completed.
+
+    Raises:
+        TimeoutError: Album tasks do not finish within five seconds.
+        Exception: The real adapter callback or delayed delivery fails.
+    """
+    for item in updates:
+        await adapter._handle_media_message(item, SimpleNamespace())
+    results = await asyncio.wait_for(asyncio.gather(*adapter._drawer_album_tasks, return_exceptions=True), 5)
+    for result in results:
+        if isinstance(result, Exception):
+            raise result
+
+
+@pytest.mark.parametrize("caption_index", [0, 2])
+@pytest.mark.parametrize("kind", ["photo", "document"])
+@pytest.mark.parametrize("slow", [False, True])
+@pytest.mark.asyncio
+async def test_all_frames(adapter: TelegramAdapter, monkeypatch: pytest.MonkeyPatch,
+                          caption_index: int, kind: str, slow: bool) -> None:
+    """Deliver every frame once even when the caption is last or downloads are slow.
+
+    Args:
+        adapter (TelegramAdapter): Isolated group-only adapter.
+        monkeypatch (pytest.MonkeyPatch): Replaces network and cache writes.
+        caption_index (int): Frame whose caption contains the mention.
+        kind (str): Photo or original image document.
+        slow (bool): Whether each download exceeds the album debounce interval.
+
+    Returns:
+        None: All three files reach a single downstream event in message order.
+
+    Raises:
+        AssertionError: A frame or caption is lost, duplicated or split.
+        TimeoutError: Album processing hangs.
+    """
+    async def download(*_args: object, **_kwargs: object) -> bytearray:
+        """Simulate a bounded file transfer.
+
+        Args:
+            *_args (object): Ignored Telegram method positional arguments.
+            **_kwargs (object): Ignored Telegram method keyword arguments.
+
+        Returns:
+            bytearray: Synthetic image bytes, handled by the mocked cache.
+        """
+        if slow:
+            await asyncio.sleep(0.04)
+        return bytearray(b"image")
+    monkeypatch.setattr(Bot, "get_file", AsyncMock(return_value=File("f", "u", file_path="photo.png")))
+    monkeypatch.setattr(File, "download_as_bytearray", download)
+    cache = AsyncMock(side_effect=["one.png", "two.png", "three.png"])
+    monkeypatch.setattr("plugins.platforms.telegram.adapter.cache_image_from_bytes_async", cache)
+    example = update(1, True, kind).message
+    assert adapter._is_user_authorized_from_message(example), "user auth"
+    assert adapter._message_mentions_bot(example), ("mention", adapter._current_bot_username())
+    assert adapter._should_process_message(example), "trigger"
+    await deliver(adapter, [update(i + 1, i == caption_index, kind) for i in range(3)])
+    adapter.handle_message.assert_awaited_once()
+    event = adapter.handle_message.call_args.args[0]
+    assert event.media_urls == ["one.png", "two.png", "three.png"]
+    assert "save every image" in event.text
+    assert "3 attachments received; 3 files available" in event.text
+    assert cache.await_count == 3
+
+
+@pytest.mark.parametrize("case", ["unmentioned", "outside", "dm", "sender", "topic", "album"])
+@pytest.mark.asyncio
+async def test_access_and_isolation(adapter: TelegramAdapter, monkeypatch: pytest.MonkeyPatch, case: str) -> None:
+    """Keep group restrictions and never borrow another conversation's mention.
+
+    Args:
+        adapter (TelegramAdapter): Isolated group-only adapter.
+        monkeypatch (pytest.MonkeyPatch): Replaces downloads and image cache writes.
+        case (str): Boundary or trigger condition to exercise.
+
+    Returns:
+        None: Only the explicitly addressed, authorized album can download files.
+
+    Raises:
+        AssertionError: An unaddressed or unauthorized frame is delivered/downloaded.
+        TimeoutError: Pending album tasks fail to complete.
+    """
+    get_file = AsyncMock(return_value=File("f", "u", file_path="photo.png"))
+    monkeypatch.setattr(Bot, "get_file", get_file)
+    monkeypatch.setattr(File, "download_as_bytearray", AsyncMock(return_value=bytearray(b"image")))
+    monkeypatch.setattr("plugins.platforms.telegram.adapter.cache_image_from_bytes_async", AsyncMock(return_value="allowed.png"))
+    if case in {"unmentioned", "outside", "dm"}:
+        chat = {"outside": -200, "dm": 111}.get(case, -100)
+        items = [update(i + 1, case != "unmentioned" and i == 0, "photo", chat_id=chat) for i in range(3)]
+        expected = 0
+    else:
+        items = [update(1, True, "photo"), update(2, False, "photo",
+                 sender=222 if case == "sender" else 111,
+                 album="b" if case == "album" else "a", topic=9 if case == "topic" else None)]
+        expected = 1
+    await deliver(adapter, items)
+    assert adapter.handle_message.await_count == expected
+    assert get_file.await_count == expected
+    if expected:
+        assert adapter.handle_message.call_args.args[0].media_urls == ["allowed.png"]
